static void draw_document(void) {
    int x, w;
    draw_sidebar(active_pane, &x, &w);

    if (!loading && !show_error)
        wrap_page();

    int doc_y = CONTENT_Y;
    int doc_h = CONTENT_H;
    int text_x = x + 5;
    int scroll_x = x + w - SCROLL_W;
    int text_w = w - SCROLL_W - 6;

    gfx_SetColor(WHITE);
    gfx_FillRectangle(x, doc_y, text_w, doc_h);
    gfx_SetColor(SHADOW);
    gfx_Rectangle(x, doc_y, text_w, doc_h);

    if (loading) {
        draw_loading_page(x, text_w);
        draw_scrollbar(scroll_x, doc_y, doc_h);
        return;
    }

    if (show_error) {
        draw_error_page(x);
        draw_scrollbar(scroll_x, doc_y, doc_h);
        return;
    }

    int doc_bottom = doc_y + doc_h - 2;

    for (uint16_t row = 0; row < VISIBLE_LINES; ++row) {
        uint16_t idx = first_line + row;
        if (idx >= line_count) break;

        int y = doc_y + 7 + row * LINE_H;
        int mid = media_token(lines[idx]);
        if (mid > 0 && mid <= media_count) {
            if (media[mid - 1].type == MEDIA_IMAGE)
                draw_media_image(&media[mid - 1], text_x, y, x + text_w - 3, doc_bottom);
            else
                draw_media_video(&media[mid - 1], text_x, y, x + text_w - 3, doc_bottom);
        } else {
            draw_linked_line(lines[idx], text_x, y, x + text_w - 3);
        }
    }

    draw_scrollbar(scroll_x, doc_y, doc_h);
}

