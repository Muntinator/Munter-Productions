static bool is_test_url(const char *u) {
    const char *p = u;

    if (!strncmp(p, "https://", 8)) p += 8;
    else if (!strncmp(p, "http://", 7)) p += 7;

    if (!strncmp(p, "www.", 4)) p += 4;

    return !strncmp(p, "test.com", 8) &&
           (p[8] == '\0' || p[8] == '/');
}

static void append_media_element(uint8_t type, const char *media_url, const char *label) {
    if (media_count >= MAX_MEDIA) return;

    uint8_t id = (uint8_t)(media_count + 1);
    media_element_t *m = &media[media_count++];

    m->type = type;
    m->playing = false;
    m->frame = 0;
    strncpy(m->url, media_url ? media_url : "", sizeof(m->url) - 1);
    m->url[sizeof(m->url) - 1] = '\0';
    strncpy(m->label, label ? label : (type == MEDIA_VIDEO ? "Video" : "Image"), sizeof(m->label) - 1);
    m->label[sizeof(m->label) - 1] = '\0';

    char token[20];
    snprintf(token, sizeof(token), type == MEDIA_VIDEO ? "[VIDEO%u]" : "[IMAGE%u]", id);
    append_text(token);
    append_text("\n");

    uint8_t rows = type == MEDIA_VIDEO ? MEDIA_VIDEO_ROWS : MEDIA_IMAGE_ROWS;
    for (uint8_t i = 0; i < rows - 1; ++i)
        append_text("\n");
}

static int media_token(const char *line) {
    unsigned n = 0;
    if (sscanf(line, "[IMAGE%u]", &n) == 1 && n >= 1 && n <= media_count && line[7] == ']')
        return (int)n;
    if (sscanf(line, "[VIDEO%u]", &n) == 1 && n >= 1 && n <= media_count && line[7] == ']')
        return (int)n;
    return 0;
}

static void draw_media_image(const media_element_t *m, int x, int y, int max_x, int bottom) {
    int w = max_x - x;
    if (w > 188) w = 188;
    if (w < 100) return;

    int h = bottom - y;
    if (h > 58) h = 58;
    if (h < 18) return;

    gfx_SetColor(SHADOW);
    gfx_FillRectangle(x + 2, y + 2, w, h);
    gfx_SetColor(WHITE);
    gfx_FillRectangle(x, y, w, h);
    gfx_SetColor(BLUE);
    gfx_Rectangle(x, y, w, h);

    int px = x + 4;
    int py = y + 4;
    int pw = w - 8;
    int ph = h - 25;
    if (ph > 30) ph = 30;

    gfx_SetColor(0x0B);
    gfx_FillRectangle(px, py, pw, ph);
    gfx_SetColor(BLUE);
    gfx_FillRectangle(px, py, pw, ph / 2);
    gfx_SetColor(0x0E);
    gfx_FillRectangle(px + pw - 18, py + 4, 10, 10);

    gfx_SetColor(0x0A);
    gfx_Line(px, py + ph - 2, px + pw / 3, py + ph - 14);
    gfx_Line(px + pw / 3, py + ph - 14, px + pw / 2, py + ph - 4);
    gfx_Line(px + pw / 2, py + ph - 4, px + pw - 5, py + ph - 18);

    gfx_SetTextFGColor(WHITE);
    gfx_PrintStringXY("IMAGE", px + 4, py + 4);

    gfx_SetTextFGColor(BLACK);
    print_clipped(m->label, x + 5, y + h - 18, clip_chars_for_width(w - 10));
    print_clipped(m->url, x + 5, y + h - 9, clip_chars_for_width(w - 10));
}

static void draw_media_video(const media_element_t *m, int x, int y, int max_x, int bottom) {
    int w = max_x - x;
    if (w > 204) w = 204;
    if (w < 120) return;

    int h = bottom - y;
    if (h > 74) h = 74;
    if (h < 20) return;

    gfx_SetColor(SHADOW);
    gfx_FillRectangle(x + 2, y + 2, w, h);
    gfx_SetColor(BLACK);
    gfx_FillRectangle(x, y, w, h);
    gfx_SetColor(WHITE);
    gfx_Rectangle(x, y, w, h);

    int px = x + 5;
    int py = y + 5;
    int pw = w - 10;
    int ph = h - 18;

    gfx_SetColor(DARK);
    gfx_FillRectangle(px, py, pw, ph);
    gfx_SetColor(BLUE);
    gfx_FillRectangle(px, py, pw, 8);

    gfx_SetTextFGColor(WHITE);
    gfx_PrintStringXY("VIDEO", px + 4, py + 1);

    int cx = px + pw / 2;
    int cy = py + ph / 2;
    gfx_SetColor(WHITE);
    gfx_Line(cx - 8, cy - 10, cx - 8, cy + 10);
    gfx_Line(cx - 8, cy - 10, cx + 9, cy);
    gfx_Line(cx + 9, cy, cx - 8, cy + 10);

    gfx_SetColor(BLUE);
    int track = pw - 10;
    int pos = (track > 0) ? ((int)m->frame * track / 19) : 0;
    gfx_FillRectangle(px + 5, y + h - 9, track, 3);
    gfx_SetColor(WHITE);
    gfx_FillRectangle(px + 5 + pos, y + h - 9, 4, 3);

    gfx_SetTextFGColor(WHITE);
    print_clipped(m->playing ? "Playing" : "Paused - press Enter/click", px + 6, y + ph - 1, clip_chars_for_width(pw - 12));
}

