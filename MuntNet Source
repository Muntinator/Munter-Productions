    strncpy(tabs[active_tab].url, url, sizeof(tabs[active_tab].url) - 1);
    tabs[active_tab].url[sizeof(tabs[active_tab].url) - 1] = '\0';
    tabs[active_tab].used = true;
    make_tab_title(active_tab);
}

static void reset_tab(uint8_t tab) {
