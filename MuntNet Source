static void push_back(const char *u) {
    if (!u || !u[0]) return;

    if (back_count < MAX_HISTORY) {
        strncpy(back_stack[back_count], u, sizeof(back_stack[back_count]) - 1);
        back_stack[back_count][sizeof(back_stack[back_count]) - 1] = '\0';
        ++back_count;
    } else {
        memmove(back_stack, back_stack + 1, sizeof(back_stack) - sizeof(back_stack[0]));
        strncpy(back_stack[MAX_HISTORY - 1], u, sizeof(back_stack[MAX_HISTORY - 1]) - 1);
        back_stack[MAX_HISTORY - 1][sizeof(back_stack[MAX_HISTORY - 1]) - 1] = '\0';
    }
}

static void push_forward(const char *u) {
    if (!u || !u[0]) return;

    if (forward_count < MAX_FORWARD) {
        strncpy(forward_stack[forward_count], u, sizeof(forward_stack[forward_count]) - 1);
        forward_stack[forward_count][sizeof(forward_stack[forward_count]) - 1] = '\0';
        ++forward_count;
    } else {
        memmove(forward_stack, forward_stack + 1, sizeof(forward_stack) - sizeof(forward_stack[0]));
        strncpy(forward_stack[MAX_FORWARD - 1], u, sizeof(forward_stack[MAX_FORWARD - 1]) - 1);
        forward_stack[MAX_FORWARD - 1][sizeof(forward_stack[MAX_FORWARD - 1]) - 1] = '\0';
    }
}

static void make_tab_title(uint8_t tab) {
    const char *p = tabs[tab].url;
    uint8_t n = 0;

    if (!strncmp(p, "https://", 8))
        p += 8;
    else if (!strncmp(p, "http://", 7))
        p += 7;

    while (*p && *p != '/' && n < sizeof(tabs[tab].title) - 1)
        tabs[tab].title[n++] = *p++;

    if (!n) {
        strcpy(tabs[tab].title, "New Tab");
    } else {
        tabs[tab].title[n] = '\0';
    }
}

