typedef struct {
    usb_device_t device;
    srl_device_t srl;
    uint8_t buffer[512];
    bool open;
} bridge_state_t;

static bridge_state_t bridge;

static usb_error_t usb_callback(usb_event_t event, void *event_data, void *callback_data) {
    bridge_state_t *b = callback_data;

    if (event == USB_DEVICE_CONNECTED_EVENT) {
        b->device = usb_RefDevice((usb_device_t)event_data);
    } else if (event == USB_DEVICE_DISCONNECTED_EVENT) {
        usb_device_t d = (usb_device_t)event_data;
        if (b->device == d) {
            if (b->open) {
                srl_Close(&b->srl);
                b->open = false;
            }
            usb_UnrefDevice(b->device);
            b->device = NULL;
        }
    }

    return USB_SUCCESS;
}

static bool ensure_serial(void) {
    if (bridge.open) return true;
    if (!bridge.device) return false;

    if (srl_Open(&bridge.srl,
                 bridge.device,
                 bridge.buffer,
                 sizeof(bridge.buffer),
                 SRL_INTERFACE_ANY,
                 115200) != SRL_SUCCESS) {
        return false;
    }

    bridge.open = true;
    return true;
}

static void bridge_write_line(const char *line) {
    if (!ensure_serial()) return;
    srl_Write(&bridge.srl, line, strlen(line));
    srl_Write(&bridge.srl, "\n", 1);
}

