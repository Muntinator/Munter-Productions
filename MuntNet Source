static void add_recent_search(const char *query) {
    if (!query || !query[0]) return;

    if (recent_search_count < MAX_RECENT_SEARCH) {
        strncpy(recent_search[recent_search_count], query, sizeof(recent_search[recent_search_count]) - 1);
        recent_search[recent_search_count][sizeof(recent_search[recent_search_count]) - 1] = '\0';
        ++recent_search_count;
    } else {
        memmove(recent_search, recent_search + 1, sizeof(recent_search) - sizeof(recent_search[0]));
        strncpy(recent_search[MAX_RECENT_SEARCH - 1], query, sizeof(recent_search[MAX_RECENT_SEARCH - 1]) - 1);
        recent_search[MAX_RECENT_SEARCH - 1][sizeof(recent_search[MAX_RECENT_SEARCH - 1]) - 1] = '\0';
    }
}

static bool custom_text_input(char *buffer, size_t capacity, bool search_mode) {
    if (!buffer || capacity < 2) return false;

    if (capacity > EDIT_MAX + 1) capacity = EDIT_MAX + 1;

    strncpy(edit_buffer, buffer, EDIT_MAX);
    edit_buffer[EDIT_MAX] = '\0';
    edit_length = (uint16_t)strlen(edit_buffer);
    if (edit_length >= capacity) edit_length = (uint16_t)(capacity - 1);
    edit_buffer[edit_length] = '\0';
    edit_cursor = edit_length;
    edit_alpha_lock = true;
    edit_symbol_next = false;
    edit_blink = true;

    edit_replace_all = true;

    dialog_mode = search_mode ? 2 : 1;
    showing_url_dialog = true;
    set_status(search_mode ? "Custom search entry" : "Custom URL entry");
    redraw();

    bool accepted = false;
    bool done = false;
    uint16_t ticks = 0;

    while (!done && running) {
        usb_HandleEvents();
        poll_serial();

        ++ticks;
        if ((ticks % 12) == 0) {
            edit_blink = !edit_blink;
            redraw();
        }

        uint8_t key = os_GetCSC();
        if (!key) continue;

        if (key == KEY_EXIT || key == sk_Clear) {
            done = true;
            accepted = false;
            break;
        }

        if (key == sk_Enter) {
            done = true;
            accepted = true;
            break;
        }

        if (key == sk_Left) {
            edit_replace_all = false;
            if (edit_cursor) --edit_cursor;
            edit_blink = true;
            redraw();
            continue;
        }

        if (key == sk_Right) {
            edit_replace_all = false;
            if (edit_cursor < edit_length) ++edit_cursor;
            edit_blink = true;
            redraw();
            continue;
        }

        if (key == sk_Del) {
            edit_replace_all = false;
            if (edit_cursor > 0 && edit_length > 0) {
                memmove(&edit_buffer[edit_cursor - 1],
                        &edit_buffer[edit_cursor],
                        edit_length - edit_cursor + 1);
                --edit_cursor;
                --edit_length;
            }
            edit_blink = true;
            redraw();
            continue;
        }

        if (key == sk_Alpha) {
            edit_replace_all = false;
            edit_alpha_lock = !edit_alpha_lock;
            edit_blink = true;
            redraw();
            continue;
        }

        if (key == sk_2nd && !edit_alpha_lock) {
            edit_replace_all = false;
            edit_symbol_next = true;
            edit_blink = true;
            redraw();
            continue;
        }

        char ch = 0;

        if (key == sk_0) ch = '0';
        else if (key == sk_1) ch = '1';
        else if (key == sk_2) ch = '2';
        else if (key == sk_3) ch = '3';
        else if (key == sk_4) ch = '4';
        else if (key == sk_5) ch = '5';
        else if (key == sk_6) ch = '6';
        else if (key == sk_7) ch = '7';
        else if (key == sk_8) ch = '8';
        else if (key == sk_9) ch = '9';
        else if (key == sk_DecPnt) ch = '.';
        else if (key == sk_Div) ch = '/';
        else if (key == sk_Sub) ch = '-';
        else if (key == sk_Add) ch = '+';
        else if (key == sk_Comma) ch = ',';
        else if (key == sk_LParen) ch = '(';
        else if (key == sk_RParen) ch = ')';
        else if (key == sk_Power) ch = '^';

        if (edit_symbol_next) {
            
            switch (key) {
                case sk_0: ch = '?'; break;
                case sk_1: ch = ':'; break;
                case sk_2: ch = ';'; break;
                case sk_3: ch = '&'; break;
                case sk_4: ch = '%'; break;
                case sk_5: ch = '#'; break;
                case sk_6: ch = '_'; break;
                case sk_7: ch = '~'; break;
                case sk_8: ch = '='; break;
                case sk_9: ch = '@'; break;
                case sk_DecPnt: ch = '_'; break;
                case sk_Div: ch = ':'; break;
                case sk_Sub: ch = '_'; break;
                case sk_Add: ch = '='; break;
                case sk_Mul: ch = '*'; break;
                default: break;
            }
            edit_symbol_next = false;
        }

        if (!ch && edit_alpha_lock) {
            switch (key) {
                case 50: ch = 'A'; break;
                case 44: ch = 'B'; break;
                case 45: ch = 'C'; break;
                case 182: ch = 'D'; break;
                case 183: ch = 'E'; break;
                case 185: ch = 'F'; break;
                case 187: ch = 'G'; break;
                case 132: ch = 'H'; break;
                case 189: ch = 'I'; break;
                case 139: ch = 'J'; break;
                case 133: ch = 'K'; break;
                case 134: ch = 'L'; break;
                case 131: ch = 'M'; break;
                case 193: ch = 'N'; break;
                case 149: ch = 'O'; break;
                case 150: ch = 'P'; break;
                case 151: ch = 'Q'; break;
                case 130: ch = 'R'; break;
                case 191: ch = 'S'; break;
                case 146: ch = 'T'; break;
                case 147: ch = 'U'; break;
                case 148: ch = 'V'; break;
                case 129: ch = 'W'; break;
                case 138: ch = 'X'; break;
                case 143: ch = 'Y'; break;
                case 144: ch = 'Z'; break;
                default: break;
            }
        }

        if (ch && edit_length < capacity) {
            
            if (edit_replace_all) {
                edit_buffer[0] = '\0';
                edit_length = 0;
                edit_cursor = 0;
                edit_replace_all = false;
            }

            if (edit_length < capacity - 1) {
                memmove(&edit_buffer[edit_cursor + 1],
                        &edit_buffer[edit_cursor],
                        edit_length - edit_cursor + 1);
                edit_buffer[edit_cursor] = ch;
                ++edit_cursor;
                ++edit_length;
                edit_blink = true;

                gfx_SetDrawBuffer();
                redraw();
            }
        }
    }

    showing_url_dialog = false;
    dialog_mode = 0;
    edit_blink = false;
    edit_replace_all = false;

    if (accepted) {
        strncpy(buffer, edit_buffer, capacity - 1);
        buffer[capacity - 1] = '\0';
    }

    redraw();
    return accepted;
}

static void search_web(void) {
    char query[80] = "";

    if (!custom_text_input(query, sizeof(query), true))
        return;

    if (!query[0]) {
        redraw();
        return;
    }

    add_recent_search(query);

    char encoded[120];
    uint16_t j = 0;

    for (uint16_t i = 0; query[i] && j < sizeof(encoded) - 1; ++i) {
        char c = query[i];
        if (c == ' ') c = '+';
        encoded[j++] = c;
    }

    encoded[j] = '\0';

    char search_url[240];
    snprintf(search_url, sizeof(search_url), "https://www.google.com/search?q=%s", encoded);
    fetch_url(search_url);
}

static void print_clipped(const char *text, int x, int y, uint8_t max_chars) {
    char buf[64];
    size_t n;

    if (max_chars >= sizeof(buf))
        max_chars = sizeof(buf) - 1;

    n = strlen(text);
    if (n <= max_chars) {
        gfx_PrintStringXY(text, x, y);
        return;
    }

    if (max_chars < 4) {
        memcpy(buf, text, max_chars);
        buf[max_chars] = '\0';
    } else {
        memcpy(buf, text, max_chars);
        buf[max_chars - 3] = '.';
        buf[max_chars - 2] = '.';
        buf[max_chars - 1] = '.';
        buf[max_chars] = '\0';
    }

    gfx_PrintStringXY(buf, x, y);
}

static uint8_t clip_chars_for_width(int pixels) {
    if (pixels <= 0) return 1;
    int n = pixels / 7;
    if (n < 1) n = 1;
    if (n > 63) n = 63;
    return (uint8_t)n;
}

static void draw_3d_button(int x, int y, int w, int h, bool focused, bool pressed, bool enabled) {
    uint8_t fill = enabled ? MID : DARK;
    uint8_t hi = enabled ? LIGHT : MID;
    uint8_t lo = SHADOW;

    gfx_SetColor(fill);
    gfx_FillRectangle(x, y, w, h);

    if (pressed) {
        gfx_SetColor(lo);
        gfx_Line(x, y, x + w - 1, y);
        gfx_Line(x, y, x, y + h - 1);
        gfx_SetColor(hi);
        gfx_Line(x, y + h - 1, x + w - 1, y + h - 1);
        gfx_Line(x + w - 1, y, x + w - 1, y + h - 1);
    } else {
        gfx_SetColor(hi);
        gfx_Line(x, y, x + w - 1, y);
        gfx_Line(x, y, x, y + h - 1);
        gfx_SetColor(lo);
        gfx_Line(x, y + h - 1, x + w - 1, y + h - 1);
        gfx_Line(x + w - 1, y, x + w - 1, y + h - 1);
    }

    if (focused) {
        gfx_SetColor(BLACK);
        gfx_Rectangle(x + 2, y + 2, w - 5, h - 5);
    }
}

