static void draw_linked_line(const char *line, int x, int y, int max_x) {
    const char *p = line;
    int px = x;

    while (*p && px < max_x) {
        if (*p == '[' && p[1] >= '1' && p[1] <= '9' && p[2] == ']') {
            uint8_t n = (uint8_t)(p[1] - '0');
            const char *next = p + 3;
            int width = 18;

            if (px + width > max_x)
                break;

            if (n == selected_link) {
                gfx_SetColor(BLUE);
                gfx_FillRectangle(px - 1, y - 1, width, 9);
                gfx_SetTextFGColor(WHITE);
            } else {
                gfx_SetTextFGColor(LINK_BLUE);
            }

            gfx_PrintStringXY((n == 1) ? "[1]" :
                              (n == 2) ? "[2]" :
                              (n == 3) ? "[3]" :
                              (n == 4) ? "[4]" :
                              (n == 5) ? "[5]" :
                              (n == 6) ? "[6]" :
                              (n == 7) ? "[7]" :
                              (n == 8) ? "[8]" : "[9]", px, y);

            gfx_SetColor(n == selected_link ? WHITE : LINK_BLUE);
            gfx_Line(px, y + 8, px + width - 2, y + 8);

            px += width;
            p = next;
        } else {
            if (px + 7 > max_x)
                break;
            char one[2] = {*p, '\0'};
            gfx_SetTextFGColor(BLACK);
            gfx_PrintStringXY(one, px, y);
            px += 7;
            ++p;
        }
    }
}

static void draw_scrollbar(int x, int y, int h) {
    draw_3d_button(x, y, SCROLL_W, h, false, false, true);

    gfx_SetTextFGColor(BLACK);
    gfx_PrintStringXY("^", x + 4, y + 1);
    gfx_PrintStringXY("v", x + 4, y + h - 11);

