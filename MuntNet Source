    int track = h - 28;
    int thumb_h = track * VISIBLE_LINES / line_count;
    if (thumb_h < 13) thumb_h = 13;

    int max_offset = line_count - VISIBLE_LINES;
    int free_track = track - thumb_h;
    int ty = y + 14;
    if (free_track > 0 && max_offset > 0)
        ty += free_track * first_line / max_offset;

    draw_3d_button(x + 2, ty, SCROLL_W - 4, thumb_h, focus_control == 15, false, true);
