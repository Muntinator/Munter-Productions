static void switch_tab(uint8_t tab) {
    if (tab >= 5) return;
    if (tab == active_tab) return;

    save_active_tab();
    active_tab = tab;

    if (tabs[tab].used && tabs[tab].url[0]) {
        strncpy(url, tabs[tab].url, sizeof(url) - 1);
        url[sizeof(url) - 1] = '\0';
        fetch_url_internal(url, false, false);
    } else {
        strcpy(url, "https://www.google.com/");
        fetch_url_internal(url, false, false);
        save_active_tab();
    }
}

static void new_tab(void) {
    uint8_t next = (uint8_t)((active_tab + 1) % 5);
    reset_tab(next);
    active_tab = next;
    strcpy(url, "https://www.google.com/");
    fetch_url_internal(url, false, false);
    save_active_tab();
}

static void close_tab(void) {
    reset_tab(active_tab);
    uint8_t next = (active_tab == 0) ? 1 : (uint8_t)(active_tab - 1);
    if (!tabs[next].used) {
        strcpy(url, "https://www.google.com/");
        fetch_url_internal(url, false, false);
        save_active_tab();
    } else {
        active_tab = next;
        strncpy(url, tabs[next].url, sizeof(url) - 1);
        url[sizeof(url) - 1] = '\0';
        fetch_url_internal(url, false, false);
    }
}

static void add_favorite_current(void) {
    if (!url[0]) return;

    for (uint8_t i = 0; i < favorite_count; ++i) {
        if (!strcmp(favorites[i], url)) {
            set_status("Already in Favorites");
            return;
        }
    }

    if (favorite_count < MAX_FAVORITES) {
        strncpy(favorites[favorite_count], url, sizeof(favorites[favorite_count]) - 1);
        favorites[favorite_count][sizeof(favorites[favorite_count]) - 1] = '\0';
        ++favorite_count;
        set_status("Added to Favorites");
    } else {
        set_status("Favorites full");
    }
}

