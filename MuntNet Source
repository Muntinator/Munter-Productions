static void fetch_url_internal(const char *u, bool add_history, bool clear_forward) {
    if (!u || !u[0]) return;

    if (add_history && url[0] && strcmp(url, u) != 0) {
        push_back(url);
        if (clear_forward)
            forward_count = 0;
    }

    strncpy(url, u, sizeof(url) - 1);
    url[sizeof(url) - 1] = '\0';

    save_active_tab();

    char cmd[300];
    snprintf(cmd, sizeof(cmd), "GET %s", url);

    clear_page();
    show_error = false;
    error_message[0] = '\0';

    if (is_test_url(url)) {
        load_offline_test_page();
        return;
    }

    loading = true;
    set_status("Connecting...");

    bridge_write_line(cmd);
}

static void normalize_url_input(const char *input, char *output, size_t capacity) {
    const char *start = input;
    size_t len;

    if (!input || !output || capacity < 2) return;

    while (*start == ' ' || *start == '\t') ++start;

    len = strlen(start);
    while (len > 0 && (start[len - 1] == ' ' || start[len - 1] == '\t'))
        --len;

    if (!len) {
        output[0] = '\0';
        return;
    }

    if ((len >= 7 && !strncmp(start, "http://", 7)) ||
        (len >= 8 && !strncmp(start, "https://", 8))) {
        size_t n = len;
        if (n >= capacity) n = capacity - 1;
        memcpy(output, start, n);
        output[n] = '\0';
        return;
    }

    if (len + 8 >= capacity) len = capacity - 9;
    memcpy(output, "https://", 8);
    memcpy(output + 8, start, len);
    output[8 + len] = '\0';
}

static void fetch_url(const char *u) {
    fetch_url_internal(u, true, true);
}

static void go_back(void) {
    if (!back_count) {
        set_status("No previous page");
        return;
    }

    push_forward(url);
    --back_count;

    fetch_url_internal(back_stack[back_count], false, false);
}

static void go_forward(void) {
    if (!forward_count) {
        set_status("No next page");
        return;
    }

    push_back(url);
    --forward_count;

    fetch_url_internal(forward_stack[forward_count], false, false);
}

