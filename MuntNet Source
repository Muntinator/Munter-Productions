static void mouse_click_toolbar(int x, int y) {
    int ty = TITLE_H + MENU_H;
    int xpos = 2;
    int widths[8] = {38, 38, 38, 38, 38, 38, 38, 38};

    if (y < ty + 2 || y >= ty + TOOL_H - 3) return;

    for (uint8_t i = 0; i < 8; ++i) {
        if (x >= xpos && x < xpos + widths[i]) {
            focus_control = (int8_t)i;
            activate_control(i);
            return;
        }
        xpos += widths[i] + 2;
    }
}

static void mouse_click_document(void) {
    int cx = (active_pane == PANE_NONE) ? 2 : 90;
    int cw = (active_pane == PANE_NONE) ? 316 : 228;

    if (active_pane != PANE_NONE &&
        point_in_rect(mouse_x, mouse_y, 2, CONTENT_Y, 86, CONTENT_H)) {
        if (mouse_y >= CONTENT_Y + 22) {
            int item = (mouse_y - (CONTENT_Y + 22)) / 12;
            if (active_pane == PANE_FAVORITES && item < favorite_count && item < 8) {
                pane_selection = (uint8_t)item;
                pane_select_open();
                return;
            }
            if (active_pane == PANE_HISTORY && item < back_count && item < 8) {
                pane_selection = (uint8_t)item;
                pane_select_open();
                return;
            }
            if (active_pane == PANE_SEARCH) {
                if (mouse_y >= CONTENT_Y + 22 && mouse_y < CONTENT_Y + 33) {
                    pane_selection = 0;
                    pane_select_open();
                    return;
                }
                if (mouse_y >= CONTENT_Y + 51) {
                    int recent = (mouse_y - (CONTENT_Y + 51)) / 11;
                    if (recent >= 0 && recent < recent_search_count && recent < 6) {
                        pane_selection = (uint8_t)(recent + 1);
                        pane_select_open();
                        return;
                    }
                }
            }
        }
        return;
    }

    if (mouse_x >= cx + cw - SCROLL_W &&
        mouse_y >= CONTENT_Y && mouse_y < CONTENT_Y + CONTENT_H) {
        int rel = mouse_y - CONTENT_Y;
        if (rel < 16) {
            page_scroll(-1);
        } else if (rel >= CONTENT_H - 16) {
            page_scroll(1);
        } else if (line_count > VISIBLE_LINES) {
            int track = CONTENT_H - 28;
            int thumb_h = track * VISIBLE_LINES / line_count;
            if (thumb_h < 13) thumb_h = 13;
            int max_offset = line_count - VISIBLE_LINES;
            int pos = rel - 14 - thumb_h / 2;
            if (pos < 0) pos = 0;
            if (pos > track - thumb_h) pos = track - thumb_h;
            first_line = (uint16_t)((max_offset * pos) / (track - thumb_h));
        }
        return;
    }

    if (point_in_rect(mouse_x, mouse_y, cx, CONTENT_Y, cw - SCROLL_W, CONTENT_H)) {
        int media_row = (mouse_y - (CONTENT_Y + 7)) / LINE_H;
        if (media_row >= 0 && media_row < VISIBLE_LINES) {
            uint16_t media_idx = first_line + (uint16_t)media_row;
            if (media_idx < line_count) {
                int mid = media_token(lines[media_idx]);
                if (mid > 0) {
                    click_media((uint8_t)mid);
                    return;
                }
            }
        }
    }

    if (point_in_rect(mouse_x, mouse_y, cx, CONTENT_Y, cw - SCROLL_W, CONTENT_H)) {
        int row = (mouse_y - (CONTENT_Y + 7)) / LINE_H;
        if (row >= 0 && row < VISIBLE_LINES) {
            uint16_t idx = first_line + (uint16_t)row;
            if (idx < line_count) {
                const char *line = lines[idx];
                int px = cx + 5;
                const char *p = line;
                while (*p) {
                    if (*p == '[' && p[1] >= '1' && p[1] <= '9' && p[2] == ']') {
                        uint8_t n = (uint8_t)(p[1] - '0');
                        if (point_in_rect(mouse_x, mouse_y, px - 1,
                                          CONTENT_Y + 7 + row * LINE_H - 1, 18, 10)) {
                            selected_link = (int8_t)n;
                            if (n >= 1 && n <= link_count)
                                fetch_url(links[n - 1]);
                            return;
                        }
                        px += 18;
                        p += 3;
                    } else {
                        px += 7;
                        ++p;
                    }
                }
                selected_link = -1;
            }
        }
    }
}

static void mouse_click(void) {

    if (showing_help || showing_about || showing_url_dialog) return;

    int menuy = TITLE_H;
    if (mouse_y >= menuy && mouse_y < menuy + MENU_H) {
        mouse_open_menu_at(mouse_x);
        return;
    }

    if (menu_open) {
        int mx = menu_x(menu_index) - 2;
        int mw = (menu_index == 4) ? 130 : 124;
        uint8_t count = menu_count(menu_index);
        int mh = count * 14 + 6;
        int my = TITLE_H + MENU_H;
        if (mx < 0) mx = 0;
        if (mx + mw > 319) mx = 319 - mw;

        if (point_in_rect(mouse_x, mouse_y, mx, my, mw, mh)) {
            int item = (mouse_y - my - 3) / 14;
            if (item >= 0 && item < count) {
                menu_item = (uint8_t)item;
                menu_action();
            }
        } else {
            menu_open = false;
        }
        return;
    }

    mouse_click_toolbar(mouse_x, mouse_y);
    if (mouse_y >= TITLE_H + MENU_H &&
        mouse_y < TITLE_H + MENU_H + TOOL_H) {
        return;
    }

    int address_y = TITLE_H + MENU_H + TOOL_H;
    if (point_in_rect(mouse_x, mouse_y, 45, address_y + 2, 252, 16)) {
        focus_control = 8;
        open_url_dialog();
        return;
    }
    if (point_in_rect(mouse_x, mouse_y, 299, address_y + 2, 18, 16)) {
        focus_control = 9;
        fetch_url(url);
        return;
    }

    int tab_y = address_y + URL_H;
    if (mouse_y >= tab_y && mouse_y < tab_y + TAB_H) {
        uint8_t t = (uint8_t)(mouse_x / 64);
        if (t < 5) {
            focus_control = (int8_t)(10 + t);
            switch_tab(t);
        }
        return;
    }

    mouse_click_document();
}

static void redraw(void) {
    gfx_SetDrawBuffer();

    gfx_SetColor(MID);
    gfx_FillScreen(MID);

    draw_titlebar();
    draw_menubar();
    draw_toolbar();
    draw_address_bar();
    draw_tabs();
    draw_document();
    draw_statusbar();

    if (menu_open)
        draw_dropdown();

    if (showing_url_dialog)
        draw_url_dialog();
    else if (showing_help)
        draw_help_dialog();
    else if (showing_about)
        draw_about_dialog();

    draw_mouse_cursor();

    gfx_SwapDraw();
}

static void parse_bridge_line(const char *line) {
    if (!strncmp(line, "BEGIN", 5)) {
        clear_page();
        show_error = false;
        loading = true;
        set_status("Receiving page...");
        redraw();
        return;
    }

    if (!strncmp(line, "LINK ", 5)) {
        unsigned n = 0;
        char href[MAX_LINK_LEN];

        if (sscanf(line, "LINK %u %239s", &n, href) == 2 &&
            n >= 1 && n <= MAX_LINKS) {
            strncpy(links[n - 1], href, MAX_LINK_LEN - 1);
            links[n - 1][MAX_LINK_LEN - 1] = '\0';
            if (n > link_count)
                link_count = (uint8_t)n;
        }
        return;
    }

    if (!strncmp(line, "TEXT ", 5)) {
        append_text(line + 5);
        append_text("\n");
        return;
    }

    if (!strncmp(line, "IMAGE ", 6)) {
        append_media_element(MEDIA_IMAGE, line + 6, "Remote image");
        return;
    }

    if (!strncmp(line, "VIDEO ", 6)) {
        append_media_element(MEDIA_VIDEO, line + 6, "Remote video");
        return;
    }

    if (!strncmp(line, "ERROR ", 6)) {
        clear_page();
        strncpy(error_message, line + 6, sizeof(error_message) - 1);
        error_message[sizeof(error_message) - 1] = '\0';
        show_error = true;
        loading = false;
        set_status("Page could not be displayed");
        redraw();
        return;
    }

    if (!strcmp(line, "END")) {
        loading = false;
        show_error = false;
        first_line = 0;
        selected_link = -1;
        set_status("Done");
        save_active_tab();
        redraw();
        return;
    }
}

static void poll_serial(void) {
    if (!bridge.open) return;

    uint8_t buf[128];
    int got = srl_Read(&bridge.srl, buf, sizeof(buf));
    if (got <= 0) return;

    for (int i = 0; i < got; ++i) {
        char c = (char)buf[i];
        if (c == '\r') continue;

        if (c == '\n') {
            rx_line[rx_len] = '\0';
            parse_bridge_line(rx_line);
            rx_len = 0;
        } else if (rx_len < sizeof(rx_line) - 1) {
            rx_line[rx_len++] = c;
        }
    }
}

static void press_control(uint8_t control) {
    pressed_control = (int8_t)control;
    pressed_frames = 3;
}

static void open_url_dialog(void) {
    char tmp[240];
    char normalized[240];

    strncpy(tmp, url, sizeof(tmp) - 1);
    tmp[sizeof(tmp) - 1] = '\0';

    if (custom_text_input(tmp, sizeof(tmp), false) && tmp[0]) {
        normalize_url_input(tmp, normalized, sizeof(normalized));
        if (normalized[0]) {
            fetch_url(normalized);
        }
    }
}

static void open_help(void) {
    showing_help = true;
    redraw();

    while (showing_help && running) {
        usb_HandleEvents();
        poll_serial();

        uint8_t k = os_GetCSC();
        if (k == KEY_EXIT || k == sk_Enter || k == KEY_SEARCH) {
            showing_help = false;
            redraw();
        }
    }
}

static void open_about(void) {
    showing_about = true;
    redraw();

    while (showing_about && running) {
        usb_HandleEvents();
        poll_serial();

        uint8_t k = os_GetCSC();
        if (k == KEY_EXIT || k == sk_Enter || k == KEY_MENU) {
            showing_about = false;
            redraw();
        }
    }
}

static void scroll_lines(int amount) {
    int next = (int)first_line + amount;

    if (next < 0) next = 0;

    if (line_count > VISIBLE_LINES &&
        next > (int)line_count - VISIBLE_LINES) {
        next = line_count - VISIBLE_LINES;
    }

    if (line_count <= VISIBLE_LINES)
        next = 0;

    first_line = (uint16_t)next;
}

static void page_scroll(int direction) {
    scroll_lines(direction * (VISIBLE_LINES - 2));
}

static void select_link(int delta) {
    if (!link_count) return;

    int n = selected_link;

    if (n < 1) {
        n = delta > 0 ? 1 : link_count;
    } else {
        n += delta;
        if (n < 1) n = link_count;
        if (n > link_count) n = 1;
    }

    selected_link = (int8_t)n;
}

static void pane_select_open(void) {
    if (active_pane == PANE_FAVORITES) {
        if (pane_selection < favorite_count)
            fetch_url(favorites[pane_selection]);
    } else if (active_pane == PANE_HISTORY) {
        if (pane_selection < back_count)
            fetch_url(back_stack[back_count - 1 - pane_selection]);
    } else if (active_pane == PANE_SEARCH) {
        if (pane_selection == 0) {
            search_web();
        } else if (pane_selection - 1 < recent_search_count) {
            char search_url[240];
            char encoded[120];
            uint16_t j = 0;
            const char *q = recent_search[pane_selection - 1];
            for (uint16_t i = 0; q[i] && j < sizeof(encoded) - 1; ++i) {
                char c = q[i];
                if (c == ' ') c = '+';
                encoded[j++] = c;
            }
            encoded[j] = '\0';
            snprintf(search_url, sizeof(search_url), "https://www.google.com/search?q=%s", encoded);
            fetch_url(search_url);
        }
    }
}

static void activate_control(uint8_t control) {
    press_control(control);

    if (control <= 7) {
        switch (control) {
            case 0: go_back(); break;
            case 1: go_forward(); break;
            case 2: stop_loading(); break;
            case 3: refresh_page(); break;
            case 4: go_home(); break;
            case 5: active_pane = PANE_FAVORITES; pane_selection = 0; break;
            case 6: active_pane = PANE_SEARCH; pane_selection = 0; search_web(); break;
            case 7: open_help(); break;
        }
        return;
    }

    if (control == 8) {
        open_url_dialog();
        return;
    }

    if (control == 9) {
        fetch_url(url);
        return;
    }

    if (control >= 10 && control <= 14) {
        switch_tab((uint8_t)(control - 10));
        return;
    }

    if (control == 15) {
        if (selected_link >= 1 && selected_link <= link_count)
            fetch_url(links[selected_link - 1]);
        else
            select_link(1);
    }
}

static void move_focus(int delta) {
    int next = focus_control;

    next += delta;

    if (next < 0) next = 15;
    if (next > 15) next = 0;

    focus_control = (int8_t)next;
}

static void menu_action(void) {
    switch (menu_index) {
        case 0:
            switch (menu_item) {
                case 0: open_url_dialog(); break;
                case 1: new_tab(); break;
                case 2: close_tab(); break;
                case 3: add_favorite_current(); break;
                case 4: running = false; break;
            }
            break;

        case 1:
            switch (menu_item) {
                case 0: open_url_dialog(); break;
                case 1: back_count = 0; set_status("History cleared"); break;
                case 2: forward_count = 0; set_status("Forward history cleared"); break;
            }
            break;

        case 2:
            switch (menu_item) {
                case 0: refresh_page(); break;
                case 1: stop_loading(); break;
                case 2: active_pane = PANE_FAVORITES; pane_selection = 0; break;
                case 3: active_pane = PANE_HISTORY; pane_selection = 0; break;
                case 4: active_pane = PANE_SEARCH; pane_selection = 0; break;
            }
            break;

        case 3:
            switch (menu_item) {
                case 0: go_back(); break;
                case 1: go_forward(); break;
                case 2: go_home(); break;
                case 3: open_url_dialog(); break;
            }
            break;

        case 4:
            switch (menu_item) {
                case 0: active_pane = PANE_FAVORITES; pane_selection = 0; break;
                case 1: add_favorite_current(); break;
            }
            break;

        case 5:
            switch (menu_item) {
                case 0: active_pane = PANE_SEARCH; pane_selection = 0; search_web(); break;
                case 1: set_status(bridge.open ? "XIAO bridge connected" : "XIAO bridge offline"); break;
                case 2: open_about(); break;
            }
            break;

        default:
            switch (menu_item) {
                case 0: open_help(); break;
                case 1: open_about(); break;
            }
            break;
    }

    menu_open = false;
}

static void handle_menu_key(uint8_t key) {
    if (key == KEY_EXIT) {
        menu_open = false;
        redraw();
        return;
    }

    if (key == sk_Left) {
        if (menu_index > 0) --menu_index;
        else menu_index = 6;
        menu_item = 0;
        return;
    }

    if (key == sk_Right) {
        if (menu_index < 6) ++menu_index;
        else menu_index = 0;
        menu_item = 0;
        return;
    }

    if (key == sk_Up) {
        uint8_t count = menu_count(menu_index);
        if (menu_item > 0) --menu_item;
        else menu_item = count ? count - 1 : 0;
        return;
    }

    if (key == sk_Down) {
        uint8_t count = menu_count(menu_index);
        if (count) {
            if (menu_item + 1 < count) ++menu_item;
            else menu_item = 0;
        }
        return;
    }

    if (key == sk_Enter) {
        menu_action();
        return;
    }
}

static void animate_video_if_needed(void) {
    static uint8_t ticks = 0;

    if (!media_count) return;

    bool any = false;
    for (uint8_t i = 0; i < media_count; ++i) {
        if (media[i].type == MEDIA_VIDEO && media[i].playing) {
            any = true;
            break;
        }
    }

    if (!any) return;

    ++ticks;
    if (ticks < 5) return;
    ticks = 0;

    for (uint8_t i = 0; i < media_count; ++i) {
        if (media[i].type == MEDIA_VIDEO && media[i].playing)
            media[i].frame = (uint8_t)((media[i].frame + 1) % 20);
    }

    redraw();
}

static void handle_keys(void) {
    uint8_t key = os_GetCSC();
    if (!key) return;

    if (menu_open) {
        handle_menu_key(key);
        redraw();
        return;
    }

    if (key == KEY_MOUSE) {
        mouse_mode = !mouse_mode;
        set_status(mouse_mode ? "Mouse mode ON - arrows move, Enter clicks"
                              : "Keyboard mode");
        redraw();
        return;
    }

    if (mouse_mode) {
        if (key == sk_Left) { mouse_move(-1, 0); redraw(); return; }
        if (key == sk_Right) { mouse_move(1, 0); redraw(); return; }
        if (key == sk_Up) { mouse_move(0, -1); redraw(); return; }
        if (key == sk_Down) { mouse_move(0, 1); redraw(); return; }
        if (key == sk_Enter) { mouse_click(); redraw(); return; }
        if (key == KEY_PAGE_UP) { page_scroll(-1); redraw(); return; }
        if (key == KEY_PAGE_DOWN) { page_scroll(1); redraw(); return; }
    }

    if (key == KEY_EXIT) {
        running = false;
        return;
    }

    if (key == KEY_MENU) {
        menu_open = true;
        menu_index = 0;
        menu_item = 0;
        return;
    }

    if (key == KEY_URL) {
        open_url_dialog();
        return;
    }

    if (key == KEY_SEARCH) {
        active_pane = PANE_SEARCH;
        search_web();
        redraw();
        return;
    }

    if (key == KEY_BACK) {
        if (active_pane != PANE_NONE) {
            active_pane = PANE_NONE;
            pane_selection = 0;
            wrap_page();
        } else {
            go_back();
        }
        redraw();
        return;
    }

    if (key == KEY_FORWARD) {
        go_forward();
        redraw();
        return;
    }

    if (key == TAB_1_KEY) {
        switch_tab(0);
        redraw();
        return;
    }
    if (key == TAB_2_KEY) {
        switch_tab(1);
        redraw();
        return;
    }
    if (key == TAB_3_KEY) {
        switch_tab(2);
        redraw();
        return;
    }
    if (key == TAB_4_KEY) {
        switch_tab(3);
        redraw();
        return;
    }
    if (key == TAB_5_KEY) {
        switch_tab(4);
        redraw();
        return;
    }

    if (key == sk_Left) {
        if (focus_control == 15) select_link(-1);
        else move_focus(-1);
        redraw();
        return;
    }

    if (key == sk_Right) {
        if (focus_control == 15) select_link(1);
        else move_focus(1);
        redraw();
        return;
    }

    if (key == sk_Up) {
        if (active_pane == PANE_FAVORITES) {
            if (pane_selection > 0) --pane_selection;
        } else if (active_pane == PANE_HISTORY) {
            if (pane_selection > 0) --pane_selection;
        } else if (active_pane == PANE_SEARCH) {
            if (pane_selection > 0) --pane_selection;
        } else {
            scroll_lines(-1);
        }
        redraw();
        return;
    }

    if (key == sk_Down) {
        if (active_pane == PANE_FAVORITES) {
            if (favorite_count && pane_selection + 1 < favorite_count && pane_selection < 7) ++pane_selection;
        } else if (active_pane == PANE_HISTORY) {
            if (back_count && pane_selection + 1 < back_count && pane_selection < 7) ++pane_selection;
        } else if (active_pane == PANE_SEARCH) {
            if (pane_selection < recent_search_count && pane_selection < 6) ++pane_selection;
        } else {
            scroll_lines(1);
        }
        redraw();
        return;
    }

    if (key == KEY_PAGE_UP) {
        page_scroll(-1);
        redraw();
        return;
    }

    if (key == KEY_PAGE_DOWN) {
        page_scroll(1);
        redraw();
        return;
    }

    if (key == sk_Enter) {
        if (active_pane != PANE_NONE)
            pane_select_open();
        else
            activate_control((uint8_t)focus_control);
        redraw();
        return;
    }

    if (key == sk_1 || key == sk_2 || key == sk_3 ||
        key == sk_4 || key == sk_5 || key == sk_6 ||
        key == sk_7 || key == sk_8 || key == sk_9) {
        int n = key - sk_1 + 1;
        if (n >= 1 && n <= link_count) {
            selected_link = (int8_t)n;
            fetch_url(links[n - 1]);
        }
        redraw();
        return;
    }
}

int main(void) {
    memset(&bridge, 0, sizeof(bridge));
    memset(tabs, 0, sizeof(tabs));
    memset(back_stack, 0, sizeof(back_stack));
    memset(forward_stack, 0, sizeof(forward_stack));
    memset(recent_search, 0, sizeof(recent_search));

    for (uint8_t i = 0; i < 5; ++i)
        reset_tab(i);

    tabs[0].used = true;
    strncpy(tabs[0].url, url, sizeof(tabs[0].url) - 1);
    tabs[0].url[sizeof(tabs[0].url) - 1] = '\0';
    make_tab_title(0);

    gfx_Begin();
    gfx_SetDrawBuffer();
    kb_SetMode(MODE_3_CONTINUOUS);

    usb_Init(
        usb_callback,
        &bridge,
        NULL,
        USB_DEFAULT_INIT_FLAGS
    );

    clear_page();
    set_status("Connect the XIAO by USB");
    redraw();

    while (running) {
        usb_HandleEvents();

        if (pressed_frames) {
            --pressed_frames;
            if (!pressed_frames)
                pressed_control = -1;
        }

        if (!bridge.open && bridge.device) {
            if (ensure_serial()) {
                set_status("XIAO connected");
                if (!page_text[0] && !loading)
                    fetch_url(url);
                redraw();
            }
        }

        poll_serial();
        handle_keys();
        animate_video_if_needed();

        if (loading)
            redraw();
    }

    if (bridge.open)
        srl_Close(&bridge.srl);

    usb_Cleanup();
    gfx_End();

    return 0;
}
