static void wrap_page(void) {
    line_count = 0;
    const char *p = page_text;
    uint16_t limit = (active_pane == PANE_NONE) ? TEXT_W_CHARS : 28;

    while (*p && line_count < MAX_LINES) {
        if (*p == '\n') {
            lines[line_count][0] = '\0';
            ++line_count;
            ++p;
            continue;
        }

        const char *start = p;
        uint16_t len = 0;
        uint16_t last_space = 0;

        while (p[len] && p[len] != '\n' && len < limit) {
            if (p[len] == ' ') last_space = len;
            ++len;
        }

        if (p[len] && p[len] != '\n' && len == limit && last_space > 0) {
            len = last_space;
        }

        memcpy(lines[line_count], start, len);
        lines[line_count][len] = '\0';
        ++line_count;

        p = start + len;
        while (*p == ' ') ++p;
        if (*p == '\n') ++p;
    }

    if (!line_count) {
        strcpy(lines[0], "(empty page)");
        line_count = 1;
    }

    if (first_line >= line_count)
        first_line = line_count - 1;
}

static void append_text(const char *text) {
    size_t used = strlen(page_text);
    size_t remaining = sizeof(page_text) - used - 1;

    while (*text && remaining) {
        char c = *text++;
        if (c == '\r') continue;
        page_text[used++] = c;
        --remaining;
    }

    page_text[used] = '\0';
    wrap_page();
}

