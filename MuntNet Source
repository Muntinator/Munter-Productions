static bool point_in_rect(int px, int py, int x, int y, int w, int h) {
    return px >= x && px < x + w && py >= y && py < y + h;
}

static void mouse_set_position(int x, int y) {
    
    if (x < 1) x = 1;
    if (y < 1) y = 1;
    if (x > 308) x = 308;
    if (y > 220) y = 220;
    mouse_x = (int16_t)x;
    mouse_y = (int16_t)y;
}

static void mouse_move(int dx, int dy) {
    mouse_set_position(mouse_x + dx * mouse_speed,
                       mouse_y + dy * mouse_speed);
}

